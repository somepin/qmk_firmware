// TAB //
COMB(tab,KC_TAB,LT(_NAV,KC_A), KC_S)
COMB(tab2,KC_TAB,KC_A, KC_S)

// ESC //
COMB(esc,KC_ESC,KC_Q, KC_W)

// BACKSPACE and DELETE //
COMB(bspc,KC_BSPC,KC_O, KC_P)
COMB(del,KC_DEL,KC_K, KC_L)
COMB(bspc2,KC_BSPC,KC_J, KC_K)
COMB(bspc3,KC_BSPC,KC_END, KC_PGUP)

// ENTER //
COMB(ent,KC_ENT,KC_L, KC_QUOT)
COMB(ent2,KC_ENT,KC_RIGHT, KC_PGDN)

// PUNCTUATION and SYMBOLS // 
COMB(bsls,KC_BSLS,KC_F, KC_J)
COMB(slsh,KC_SLSH,KC_COMMA, MT(MOD_RSFT,KC_DOT))
COMB(grv,KC_GRV,KC_W, KC_E)

// SPACE FOR 30% BOARDS //
//COMB(spc1,KC_SPACE,KC_K, KC_L)
//COMB(spc2,KC_SPACE,KC_S, KC_D)
  
// MODS //
COMB(gui,KC_LGUI,KC_LCTRL, KC_LALT)

// FUNCTION KEYS //
COMB(f1,KC_F1,KC_F, KC_1)
COMB(f2,KC_F2,KC_F, KC_2)
COMB(f3,KC_F3,KC_F, KC_3)
COMB(f4,KC_F4,KC_F, KC_4)
COMB(f5,KC_F5,KC_F, KC_5)
COMB(f6,KC_F6,KC_F, KC_6)
COMB(f7,KC_F7,KC_F, KC_7)
COMB(f8,KC_F8,KC_F, KC_8)
COMB(f9,KC_F9,KC_F, KC_9)
COMB(f10,KC_F10,KC_F, KC_0)
COMB(f11,KC_F11,KC_G, KC_1)
COMB(f12,KC_F12,KC_G, KC_2)

// NUMBERS //
COMB(n1,KC_1,KC_N, KC_Q)
COMB(n2,KC_2,KC_N, KC_W)
COMB(n3,KC_3,KC_N, KC_E)
COMB(n4,KC_4,KC_N, KC_R)
COMB(n5,KC_5,KC_N, KC_T)
COMB(n6,KC_6,KC_N, KC_Y)
COMB(n7,KC_7,KC_N, KC_U)
COMB(n8,KC_8,KC_N, KC_I)
COMB(n9,KC_9,KC_N, KC_O)
COMB(n0,KC_0,KC_N, KC_P)

// LAYER LOCKING //
COMB(locknav,TO(_NAV),KC_K, KC_D)
COMB(locknav2,TO(_BASE),KC_BSPC, KC_DOWN)


//////////
// MATH //
//////////

// LYX and LATEX //
SUBS(figure,SS_TAP(X_LALT)"iaf",KC_F, KC_I,KC_G)
COMB(domath,DOMATH,KC_E, KC_M)
COMB(mathfrac,MATHFRAC,KC_M, KC_F)
COMB(mathenvcenter,MATHENVCENTER,KC_M, KC_E, KC_C)
COMB(copydown,COPYDOWN,KC_C, KC_D)
SUBS(mathalpha,SS_TAP(X_BSLS)"alpha ",KC_M,LT(_NAV,KC_A))
SUBS(mathbeta,SS_TAP(X_BSLS)"beta ",KC_M,KC_B)
SUBS(mathlambda,SS_TAP(X_BSLS)"lambda ",KC_M,KC_L)
SUBS(mathmu,SS_TAP(X_BSLS)"mu ",KC_M,KC_U)
SUBS(mathpartial,SS_TAP(X_BSLS)"partial ",KC_M,KC_P)
COMB(linedown,LINEDOWN,KC_D, KC_L)
SUBS(mathcirc,SS_TAP(X_BSLS)"circ ",KC_M,KC_C)
SUBS(implies,SS_TAP(X_BSLS)"Rightarrow ",KC_I,KC_M,KC_P)
SUBS(iff,SS_TAP(X_BSLS)"Leftrightarrow ",KC_I,KC_F)

// ATOM //
SUBS(fold,SS_DOWN(X_LALT)SS_DOWN(X_LCTL)"["SS_UP(X_LCTL)SS_UP(X_LALT),KC_F,KC_O)
SUBS(unfold,SS_DOWN(X_LALT)SS_DOWN(X_LCTL)"]"SS_UP(X_LCTL)SS_UP(X_LALT),KC_F,KC_U)


//SURROUNDS//
SUBS(mathsurround,SS_DOWN(X_RALT)SS_TAP(X_M)SS_UP(X_RALT)SS_DOWN(X_LSHIFT)SS_TAP(X_9)SS_UP(X_LSHIFT),KC_M,KC_O)
SUBS(mathsurroundsquig,SS_DOWN(X_RALT)SS_TAP(X_M)SS_UP(X_RALT)SS_DOWN(X_LSHIFT)SS_TAP(X_LBRC)SS_UP(X_LSHIFT),KC_M,KC_I)
SUBS(mathsurround2,SS_DOWN(X_RALT)SS_TAP(X_M)SS_UP(X_RALT)SS_DOWN(X_LSHIFT)SS_TAP(X_9)SS_UP(X_LSHIFT),KC_S,KC_O)
SUBS(mathsurroundsquig2,SS_DOWN(X_RALT)SS_TAP(X_M)SS_UP(X_RALT)SS_DOWN(X_LSHIFT)SS_TAP(X_LBRC)SS_UP(X_LSHIFT),KC_S,KC_I)
SUBS(mathsurroundsquare2,SS_DOWN(X_RALT)SS_TAP(X_M)SS_UP(X_RALT)SS_TAP(X_LBRC),KC_S,KC_U)

//RELATIONS//
SUBS(geq,SS_TAP(X_BSLS)"geq ",KC_G,KC_T)
SUBS(leq,SS_TAP(X_BSLS)"leq ",KC_L,KC_T)
SUBS(pref,SS_TAP(X_BSLS)"succ ",KC_S,KC_U)
SUBS(prefeq,SS_TAP(X_BSLS)"succsim ",KC_S,KC_U,KC_E)

//////////
// MATH //
//////////

// R //
SUBS(notapipie,"%>%",KC_N,KC_P)

//////////////////////
// VIM-LIKE EDITING //
//////////////////////
// COPY AND CUT BY WORD OR LINE //
COMB(cutword,CUTWORD,KC_X, KC_J, KC_K, KC_L)
COMB(copyword,COPYWORD,KC_C, KC_J, KC_K, KC_L)
COMB(cutline,CUTLINE,KC_X, KC_U, KC_I, KC_O)
COMB(copyline,COPYLINE,KC_C, KC_U, KC_I, KC_O)

// VIM KILL //
//SUBS(killfoward,SS_TAP(X_DEL),KC_F, KC_K, KC_L)
//SUBS(killbackwards,SS_TAP(X_BSPC),KC_F, KC_J, KC_K)
SUBS(killtonextword,SS_DOWN(X_LCTRL)SS_TAP(X_DEL)SS_UP(X_LCTRL),KC_F, KC_L, KC_K)
SUBS(killtobeginingword,SS_DOWN(X_LCTRL)SS_TAP(X_BSPC)SS_UP(X_LCTRL),KC_F, KC_J, KC_K)
SUBS(killword,SS_DOWN(X_LCTRL)SS_TAP(X_RIGHT)SS_TAP(X_BSPC)SS_UP(X_LCTRL)SS_TAP(X_SPACE)SS_TAP(X_LEFT),KC_F, KC_J, KC_K, KC_L)
SUBS(killlinetoend,SS_DOWN(X_LSHIFT)SS_TAP(X_END)SS_UP(X_LSHIFT)SS_TAP(X_BSPC),KC_F, KC_I,KC_O)
SUBS(killlinetobeg,SS_DOWN(X_LSHIFT)SS_TAP(X_HOME)SS_UP(X_LSHIFT)SS_TAP(X_BSPC),KC_F, KC_U,KC_I)
SUBS(killline,SS_TAP(X_HOME)SS_DOWN(X_LSHIFT)SS_TAP(X_END)SS_UP(X_LSHIFT)SS_TAP(X_BSPC),KC_F, KC_U,KC_I,KC_O)
SUBS(killline2,SS_TAP(X_HOME)SS_DOWN(X_LSHIFT)SS_TAP(X_END)SS_UP(X_LSHIFT)SS_TAP(X_BSPC)SS_TAP(X_DEL),KC_J, KC_K,KC_L)
SUBS(copyline2,SS_TAP(X_HOME)SS_DOWN(X_LSHIFT)SS_TAP(X_END)SS_UP(X_LSHIFT)SS_DOWN(X_LCTL)SS_TAP(X_C)SS_UP(X_LCTL)SS_TAP(X_END)SS_TAP(X_ENT)SS_DOWN(X_LCTL)SS_TAP(X_V)SS_UP(X_LCTL),KC_U, KC_I,KC_O)
//////////////////////////
// END VIM-LIKE EDITING //
//////////////////////////

// SHIFT LOCK //
COMB(shiftlock,LOCK_SHIFT,KC_G, KC_H)

COMB(jumpword,JUMP_WORD,KC_S, KC_J)
COMB(jumpagain,JUMP_AGAIN,KC_D, KC_J)
COMB(jumpchar,JUMP_CHAR,LT(_NAV,KC_A), KC_J)
COMB(pop,POP,KC_K,KC_V)
COMB(push,PUSH,KC_K,KC_C)
COMB(killpush,PUSH_KILL,KC_K,KC_X)
COMB(dup,DUP,KC_K,KC_G)
// CUT,COPY,PASTE //
COMB(cut,CUT,KC_J, KC_X)
COMB(copy,COPY,KC_J, KC_C)
COMB(paste,PASTE,KC_J, KC_V)

